{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionhub.dev/schemas/actionhub.schema.json",
  "title": "ActionHub workflow manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "license", "authors"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "description": "Slug of the workflow, lowercase and hyphen-separated."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic version of the package."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+$",
      "description": "SPDX license identifier, for example MIT or Apache-2.0."
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
          "url": {"type": "string", "pattern": "^https?://"},
          "affiliation": {"type": "string", "maxLength": 120}
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 30}
    },
    "repository": {
      "type": "string",
      "pattern": "^https?://"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://"
    }
  }
}
