FLASK_APP_NAME="ActionHub (dev)"
FLASK_ENV=development
DOMAIN=localhost
MARIADB_HOSTNAME=db
MARIADB_PORT=3306
MARIADB_DATABASE=uvlhubdb
MARIADB_TEST_DATABASE=uvlhubdb_test
MARIADB_USER=uvlhubdb_user
MARIADB_PASSWORD=uvlhubdb_password
MARIADB_ROOT_PASSWORD=uvlhubdb_root_password
WORKING_DIR=/workspace/
# Development talks to fakenodo, so no Zenodo token is needed. To use the
# Zenodo sandbox instead, remove these lines and set ZENODO_ACCESS_TOKEN.
ZENODO_API_URL=http://fakenodo:8000/api/deposit/depositions
# Browser-facing base for the "Zenodo record" link. It cannot be fakenodo's
# container hostname (that only resolves inside Compose), so the dev stack
# publishes port 8000 and links through localhost.
ZENODO_RECORD_URL=http://localhost:8000/api/deposit/depositions
